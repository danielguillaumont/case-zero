# ==========================================================
# CASE//ZERO
# Environment Configuration Template
# ==========================================================


# ----------------------------------------------------------
# Application
# ----------------------------------------------------------

# development | test | production
APP_ENV=development


# ----------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------

POSTGRES_USER=casezero

# Replace this value.
# Never use the example value in production.
POSTGRES_PASSWORD=replace_with_secure_database_password

POSTGRES_DB=casezero
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# ----------------------------------------------------------
# Authentication
# ----------------------------------------------------------

# Replace with a long cryptographically random secret.
# Never commit the real secret to Git.
JWT_SECRET_KEY=replace_with_long_random_secret

JWT_ACCESS_TOKEN_MINUTES=60


# ----------------------------------------------------------
# FastAPI
# ----------------------------------------------------------

# Development:
#   localhost,127.0.0.1,testserver
#
# Production:
#   replace with the real API hostname.
CASE_ZERO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver


# Swagger / OpenAPI documentation.
#
# Recommended:
# development = true
# production  = false
CASE_ZERO_API_DOCS_ENABLED=true


# ----------------------------------------------------------
# Frontend
# ----------------------------------------------------------

# Server-side URL used by the Next.js application
# to communicate with the CASE//ZERO API.
#
# Local development:
CASE_ZERO_API_URL=http://127.0.0.1:8000